    scrollbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      size = { 100% -1 }
      alwaystransparent = no

      scrollwidget = {
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 4

    ### ACM_MOD_SLOTS_BEGIN
    text_single = {
      layoutpolicy_horizontal = expanding
      text = "ucm_acm_gui_modifiers_hint"
      max_width = 520
    }
    ucm_acm_mod_slot_m1 = {}
    ucm_acm_mod_slot_m2 = {}
    ucm_acm_mod_slot_m3 = {}
    ucm_acm_mod_slot_m4 = {}
