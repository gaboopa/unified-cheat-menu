      scrollbox = {
        size = { 600 540 }
        visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'settings' )]"
        blockoverride "scrollbox_content" {
          vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_SETTINGS" using = Font_Size_Big default_format = "#high" }
            text_single = { layoutpolicy_horizontal = expanding text = "UCM_SEC_MENU" using = Font_Size_Medium default_format = "#high" }
            hbox = {
              layoutpolicy_horizontal = expanding
              spacing = 4
              button_standard = {
                layoutpolicy_horizontal = expanding
                size = { 0 30 }
                text_single = { parentanchor = vcenter|left position = { 10 0 } text = "ucm_second_clear" using = Font_Size_Small }
