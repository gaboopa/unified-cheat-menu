# AUTO-GENERATED by tools/gen_pickers.py; edit there, not this file.
window = {
  name = "ucm_picker_culture_window"
  parentanchor = right|vcenter
  size = { 500 720 }
  layer = top
  movable = yes
  alwaystransparent = no
  filter_mouse = all
  visible = "[GetScriptedGui( 'ucm_picker_culture_visible' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
  widget = {
    size = { 100% 100% }
    background = { using = Background_Area_Dark alpha = 1.0 }
  }
  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6
    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" { text = "UCM_PICKER_CULTURE" }
      blockoverride "button_close" { onclick = "[GetScriptedGui( 'ucm_picker_culture_close' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    }
    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 460 text = "UCM_PICKER_CULTURE_NOTE" default_format = "#low" }
    scrollbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      blockoverride "scrollbox_content" {
        vbox = {
          layoutpolicy_horizontal = expanding
          datamodel = "[GetGlobalList('ucm_picker_heritages')]"
          item = {
            vbox = {
              layoutpolicy_horizontal = expanding
              datacontext = "[Scope.Culture.GetHeritage]"
              button_standard_hover = {
                layoutpolicy_horizontal = expanding
                size = { 0 30 }
                onclick = "[GetVariableSystem.Toggle(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                text_single = { parentanchor = vcenter|left position = { 8 0 } text = "[CulturePillar.GetNameNoTooltip]" default_format = "#high" }
              }
              vbox = {
                layoutpolicy_horizontal = expanding
                margin_left = 12
                datamodel = "[CulturePillar.GetCulturesWithPillar]"
                visible = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                item = {
                  button_standard_hover = {
                    layoutpolicy_horizontal = expanding
                    size = { 0 28 }
                    onclick = "[GetScriptedGui('ucm_picker_culture_pick').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', Culture.MakeScope).End)]"
                    text_single = { parentanchor = vcenter|left position = { 8 0 } text = "[Culture.GetNameNoTooltip]" default_format = "#clickable" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
