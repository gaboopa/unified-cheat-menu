        size = { 0 30 }
        text = "ucm_acm_type_tapestry"
        down = "[GetScriptedGui('ucm_acm_gui_sel_type_tapestry').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
