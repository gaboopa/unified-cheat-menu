    }
    vbox = {
      layoutpolicy_horizontal = expanding
      visible = "[GetScriptedGui('ucm_acm_gui_is_armors_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      spacing = 4
      hbox = {
