window = {
  name = "ucm_artifact_craft_window"
  parentanchor = top|right
  position = { -32 48 }
  # 不用 Window_Size_Sidebar：该模板会在右侧留出装饰性透明区，易透地图
  using = Window_Size_MainTab
  # 不用 Window_Background：与底衬叠加易半透明；底衬单独铺满即可
  minimumsize = { 720 520 }
  maximumsize = { 820 1200 }
  size = { 760 1080 }
  # 作弊式独立窗：须挡住原版 UI 点击；windows_layer 过低会被地图/侧栏吃掉点击
  layer = top
  movable = yes
  alwaystransparent = no
  filter_mouse = all
  allow_outside = no
  visible = "[GetScriptedGui( 'ucm_acm_gui_open_visible' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

  # 全窗不透明底衬（无 alwaystransparent，避免部分版本不绘制背景）
  widget = {
    # CK3 1.20: "fill" is not an anchor; size = { 100% 100% } already fills the parent
    position = { 0 0 }
    size = { 100% 100% }
    background = {
      using = Background_Area_Dark
      alpha = 1.0
    }
  }

  vbox = {
    datacontext = "[GetPlayer]"
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" {
        text = "ucm_acm_gui_window_title"
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('ucm_acm_gui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
    }

    text_single = {
      layoutpolicy_horizontal = expanding
      text = "ucm_acm_gui_kind_row"
      default_format = "#weak"
    }
    hbox = {
      spacing = 4
      layoutpolicy_horizontal = expanding
      button_standard = {
        layoutpolicy_horizontal = expanding
        text = "ucm_acm_gui_tab_weapon"
        down = "[GetScriptedGui('ucm_acm_gui_is_weapons_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_category_weapons').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
      button_standard = {
        layoutpolicy_horizontal = expanding
        text = "ucm_acm_gui_tab_armor"
        down = "[GetScriptedGui('ucm_acm_gui_is_armors_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_category_armors').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
      button_standard = {
        layoutpolicy_horizontal = expanding
        text = "ucm_acm_gui_tab_regalia"
        down = "[GetScriptedGui('ucm_acm_gui_is_regalia_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_category_regalia').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
      button_standard = {
        layoutpolicy_horizontal = expanding
        text = "ucm_acm_gui_tab_court"
        down = "[GetScriptedGui('ucm_acm_gui_is_court_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_category_court').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
    }
    text_single = {
      layoutpolicy_horizontal = expanding
      text = "ucm_acm_gui_type_row"
      default_format = "#weak"
    }
    vbox = {
      layoutpolicy_horizontal = expanding
      visible = "[GetScriptedGui('ucm_acm_gui_is_weapons_category').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      spacing = 4
      hbox = {
        spacing = 4
        layoutpolicy_horizontal = expanding
      button_standard = {
        layoutpolicy_horizontal = expanding
        size = { 0 30 }
        text = "ucm_acm_type_axe"
        down = "[GetScriptedGui('ucm_acm_gui_sel_type_axe').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_type_axe').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
