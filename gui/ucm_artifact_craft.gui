      button_standard = {
        layoutpolicy_horizontal = expanding
        size = { 0 30 }
        text = "ucm_acm_type_small_box"
        down = "[GetScriptedGui('ucm_acm_gui_sel_type_small_box').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
