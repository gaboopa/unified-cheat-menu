      }
      button_standard = {
        layoutpolicy_horizontal = expanding
        size = { 0 30 }
        text = "ucm_acm_type_throne"
        down = "[GetScriptedGui('ucm_acm_gui_sel_type_throne').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
        downframe = 4
        upframe = 1
        onclick = "[GetScriptedGui('ucm_acm_gui_pick_type_throne').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
