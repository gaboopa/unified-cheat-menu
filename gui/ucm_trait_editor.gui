# Originally generated by tools/gen_trait_editor_gui.py (script no longer in this repo; maintained by hand)
# 本体特质：分类侧栏 + 滚动列表（替代事件弹窗链）

window = {
  name = "ucm_trait_editor_window"
  parentanchor = center
  position = { 0 0 }
  size = { 980 720 }
  layer = top
  filter_mouse = all
  allow_outside = no
  alwaystransparent = no
  movable = yes

  widget = {
    # CK3 1.20: "fill" is not an anchor; size = { 100% 100% } already fills the parent
    size = { 100% 100% }
    background = {
      using = Background_Area_Dark
      alpha = 1.0
    }
  }

  datacontext = "[GetVariableSystem]"
  datacontext = "[GetPlayer]"

  visible = "[GetScriptedGui('ucm_trait_gui_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

  state = {
    name = trait_gui_init
    trigger_on_create = yes
    on_start = "[GetVariableSystem.Set('ucm_trait_gui_category', 'childhood')]"
  }

  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" {
        text = "ucm_trait_gui_window_title"
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('ucm_trait_gui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      spacing = 10
      margin = { 4 0 }

      portrait_head_small = {
        datacontext = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char]"
      }

      text_single = {
        layoutpolicy_horizontal = expanding
        text = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.GetShortUINameNoTooltip]"
        default_format = "#high"
        align = left|nobaseline
        autoresize = yes
      }
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      spacing = 10

      scrollbox = {
        minimumsize = { 220 0 }
        maximumsize = { 240 -1 }
        layoutpolicy_vertical = expanding

        blockoverride "scrollbox_content" {
          vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 2
            margin = { 0 4 }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            onclick = "[GetVariableSystem.Set('ucm_trait_gui_category', 'childhood')]"
            down = "[GetVariableSystem.HasValue('ucm_trait_gui_category', 'childhood')]"
            text = "ucm_cheat_menu.0100.cat_childhood"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            onclick = "[GetVariableSystem.Set('ucm_trait_gui_category', 'personality')]"
