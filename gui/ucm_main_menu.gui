                tooltip = "[GetPlayer.MakeScope.Var( 'ucm_target' ).Char.GetPlayerInteractionTooltip( 'ucm_create_titular' )]"
                onclick = "[GetPlayer.MakeScope.Var( 'ucm_target' ).Char.OpenPlayerInteraction( 'ucm_create_titular' )]"
              }
            }
            hbox = {
              layoutpolicy_horizontal = expanding
