								text_single = {
									visible = "[GetScriptedGui('ucm_lifestyle_has_voyager_perk').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									text = "ucm_lifestyle_remove"
								}
								text_single = {
									visible = "[Not(GetScriptedGui('ucm_lifestyle_has_voyager_perk').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
									text = "ucm_lifestyle_grant"
								}
							}
						}
					}
				}
			}
		}
	}
}
