# Unified Cheat Menu: main menu (spec Section 2, Layer 2). Opened by the ucm_open_cheat_menu interaction.
# Tabs are GUI-only state (GetVariableSystem 'ucm_tab'); buttons run scripted GUIs from common/scripted_guis/ucm_sguis.txt.
window = {
  name = "ucm_main_menu_window"
  parentanchor = center
  size = { 760 600 }
  layer = top
  movable = yes
  alwaystransparent = no
  filter_mouse = all
  visible = "[GetScriptedGui( 'ucm_menu_visible' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

  widget = {
    size = { 100% 100% }
    background = { using = Background_Area_Dark alpha = 1.0 }
  }

  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 8

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" { text = "UCM_MENU_TITLE" }
      blockoverride "button_close" { onclick = "[GetScriptedGui( 'ucm_menu_close' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
    }

    text_single = { layoutpolicy_horizontal = expanding text = "UCM_MENU_TARGET" }
    text_single = {
      layoutpolicy_horizontal = expanding
      visible = "[GetGlobalVariable( 'skonester_crozier_cheats_other' ).IsSet]"
      text = "UCM_MENU_SECOND"
    }
    text_single = {
      layoutpolicy_horizontal = expanding
      visible = "[Not( GetGlobalVariable( 'skonester_crozier_cheats_other' ).IsSet )]"
      text = "UCM_MENU_SECOND_NONE"
      default_format = "#low"
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      spacing = 12

      # Category tabs
      vbox = {
        layoutpolicy_vertical = expanding
        spacing = 4
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_QUICK"
          down = "[Or( GetVariableSystem.HasValue( 'ucm_tab', 'quick' ), Not( GetVariableSystem.Exists( 'ucm_tab' ) ) )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'quick' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_CHARACTER"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'character' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'character' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_RELATIONSHIPS"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'relationships' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'relationships' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_TITLES"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'titles' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'titles' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_FAITH_CULTURE"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'faith_culture' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'faith_culture' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_REALM"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'realm' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'realm' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_MILITARY"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'military' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'military' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_ARTIFACTS"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'artifacts' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'artifacts' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_COURT"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'court' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'court' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_DLC"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'dlc' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'dlc' )]"
        }
        button_standard = {
          size = { 220 34 }
          text = "UCM_TAB_SETTINGS"
          down = "[GetVariableSystem.HasValue( 'ucm_tab', 'settings' )]"
          onclick = "[GetVariableSystem.Set( 'ucm_tab', 'settings' )]"
        }
        expand = {}
      }

      # Category contents
      vbox = {
        layoutpolicy_horizontal = expanding
        layoutpolicy_vertical = expanding
        spacing = 6
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[Or( GetVariableSystem.HasValue( 'ucm_tab', 'quick' ), Not( GetVariableSystem.Exists( 'ucm_tab' ) ) )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_QUICK" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_quick_gold"
            tooltip = "ucm_quick_gold_tt"
            enabled = "[GetScriptedGui( 'ucm_quick_gold' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_quick_gold' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_quick_prestige"
            tooltip = "ucm_quick_prestige_tt"
            enabled = "[GetScriptedGui( 'ucm_quick_prestige' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_quick_prestige' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_quick_piety"
            tooltip = "ucm_quick_piety_tt"
            enabled = "[GetScriptedGui( 'ucm_quick_piety' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_quick_piety' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'character' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_CHARACTER" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_trait_editor"
            tooltip = "ucm_open_trait_editor_tt"
            enabled = "[GetScriptedGui( 'ucm_open_trait_editor' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_trait_editor' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_cheat_trait_editor"
            tooltip = "ucm_open_cheat_trait_editor_tt"
            enabled = "[GetScriptedGui( 'ucm_open_cheat_trait_editor' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_cheat_trait_editor' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_lifestyle_editor"
            tooltip = "ucm_open_lifestyle_editor_tt"
            enabled = "[GetScriptedGui( 'ucm_open_lifestyle_editor' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_lifestyle_editor' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'relationships' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_RELATIONSHIPS" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_second_set_target"
            tooltip = "ucm_second_set_target_tt"
            enabled = "[GetScriptedGui( 'ucm_second_set_target' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_second_set_target' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_second_clear"
            tooltip = "ucm_second_clear_tt"
            enabled = "[GetScriptedGui( 'ucm_second_clear' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_second_clear' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'titles' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_TITLES" using = Font_Size_Big default_format = "#high" }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'faith_culture' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_FAITH_CULTURE" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_culture_picker"
            tooltip = "ucm_open_culture_picker_tt"
            enabled = "[GetScriptedGui( 'ucm_open_culture_picker' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_culture_picker' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_religion_picker"
            tooltip = "ucm_open_religion_picker_tt"
            enabled = "[GetScriptedGui( 'ucm_open_religion_picker' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_religion_picker' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_tradition_picker"
            tooltip = "ucm_open_tradition_picker_tt"
            enabled = "[GetScriptedGui( 'ucm_open_tradition_picker' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_tradition_picker' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'realm' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_REALM" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_group_sub_realm_max_development"
            tooltip = "ucm_group_sub_realm_max_development_tt"
            enabled = "[GetScriptedGui( 'ucm_group_sub_realm_max_development' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_group_sub_realm_max_development' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_group_sub_realm_max_control"
            tooltip = "ucm_group_sub_realm_max_control_tt"
            enabled = "[GetScriptedGui( 'ucm_group_sub_realm_max_control' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_group_sub_realm_max_control' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'military' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_MILITARY" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_army_spawner"
            tooltip = "ucm_open_army_spawner_tt"
            enabled = "[GetScriptedGui( 'ucm_open_army_spawner' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_army_spawner' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'artifacts' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_ARTIFACTS" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_artifact_crafter"
            tooltip = "ucm_open_artifact_crafter_tt"
            enabled = "[GetScriptedGui( 'ucm_open_artifact_crafter' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_artifact_crafter' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_artifact_repair"
            tooltip = "ucm_open_artifact_repair_tt"
            enabled = "[GetScriptedGui( 'ucm_open_artifact_repair' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_artifact_repair' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'court' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_COURT" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_group_courtiers_clear_stress"
            tooltip = "ucm_group_courtiers_clear_stress_tt"
            enabled = "[GetScriptedGui( 'ucm_group_courtiers_clear_stress' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_group_courtiers_clear_stress' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'dlc' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_DLC" using = Font_Size_Big default_format = "#high" }
          text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 480 text = "UCM_TAB_LATER" default_format = "#low" }
        }
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 6
          visible = "[GetVariableSystem.HasValue( 'ucm_tab', 'settings' )]"
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_SETTINGS" using = Font_Size_Big default_format = "#high" }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_open_console_helper"
            tooltip = "ucm_open_console_helper_tt"
            enabled = "[GetScriptedGui( 'ucm_open_console_helper' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_open_console_helper' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
          button_standard = {
            layoutpolicy_horizontal = expanding
            size = { 0 34 }
            text = "ucm_second_clear"
            tooltip = "ucm_second_clear_tt"
            enabled = "[GetScriptedGui( 'ucm_second_clear' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            onclick = "[GetScriptedGui( 'ucm_second_clear' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
          }
        }
        expand = {}
      }
    }
  }
}
