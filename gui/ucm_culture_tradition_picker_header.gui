template ucmCw_Tradition_Picker_Header
{
  restrictparent_min = yes
  using = Window_Margins

  header_pattern = {
    layoutpolicy_horizontal = expanding

    blockoverride "header_text"
    {
      text = ucm_cw_tradition_menu_title
    }

    blockoverride "button_close"
    {
      onclick = "[GetVariableSystem.Clear('ucm_cw_tradition_picker_visible')]"
      onclick = "[GetScriptedGui('ucm_cw_close_tradition_picker_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
  }
}
