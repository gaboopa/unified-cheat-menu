          text_single = { layoutpolicy_horizontal = expanding text = "UCM_PILLAR_HERITAGE" default_format = "#high" }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_heritage_ainuic' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_heritage_ainuic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_heritage_ainuic' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "heritage_ainuic_name" using = Font_Size_Small } }
