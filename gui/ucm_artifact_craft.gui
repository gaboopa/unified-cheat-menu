      state = {
        name = ucm_acm_name_preview_refresh
        trigger_when = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('ucm_acm_gui_preview_tick').GetValue, '(CFixedPoint)0' )]"
      }
    }
    text_single = {
      layoutpolicy_horizontal = expanding
      max_width = 520
      default_format = "#weak"
      raw_text = "[Localize('ucm_acm_edit_gui_desc_preview_prefix')][GetPlayer.Custom('ucm_acm_edit_desc_preview_display')]"

