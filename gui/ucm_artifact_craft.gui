    button_standard = {
      layoutpolicy_horizontal = expanding
      text = "ucm_acm_gui_close_button"
      onclick = "[GetScriptedGui('ucm_acm_gui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }

    button_primary = {
      layoutpolicy_horizontal = expanding
      size = { 0 44 }
      text = "ucm_acm_gui_create"
      onclick = "[GetScriptedGui( 'ucm_acm_gui_create' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }
  }
}
