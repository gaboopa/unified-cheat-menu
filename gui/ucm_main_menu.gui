          vbox = {
            layoutpolicy_horizontal = expanding
            spacing = 4
            text_single = { layoutpolicy_horizontal = expanding text = "UCM_TAB_TITLES" using = Font_Size_Big default_format = "#high" }
            text_single = { layoutpolicy_horizontal = expanding text = "UCM_SEC_CLAIMS" using = Font_Size_Medium default_format = "#high" }
            hbox = {
              layoutpolicy_horizontal = expanding
              spacing = 4
