# Originally generated by tools/gen_cheat_trait_gui.py (script no longer in this repo; maintained by hand)
# 自制特质：单列表滚动

window = {
  name = "ucm_cheat_trait_editor_window"
  parentanchor = center
  position = { 0 0 }
  size = { 720 640 }
  layer = top
  filter_mouse = all
  allow_outside = no
  alwaystransparent = no
  movable = yes

  widget = {
    # CK3 1.20: "fill" is not an anchor; size = { 100% 100% } already fills the parent
    size = { 100% 100% }
    background = {
      using = Background_Area_Dark
      alpha = 1.0
    }
  }

  datacontext = "[GetPlayer]"

  visible = "[GetScriptedGui('ucm_cheat_trait_gui_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" {
        text = "ucm_cheat_trait_gui_window_title"
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('ucm_cheat_trait_gui_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      spacing = 10
      margin = { 4 0 }

      portrait_head_small = {
        datacontext = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char]"
      }

      text_single = {
        layoutpolicy_horizontal = expanding
        text = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.GetShortUINameNoTooltip]"
        default_format = "#high"
        align = left|nobaseline
        autoresize = yes
      }
    }

    scrollbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding

      blockoverride "scrollbox_content" {
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 4
            button_standard_hover = {
              layoutpolicy_horizontal = expanding
              size = { 0 38 }
              datacontext = "[GetTrait('ucm_trait_immortal_ageless')]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char]"
              down = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_immortal_ageless'))]"
              onclick = "[GetScriptedGui('ucm_cheat_trait_gui_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trait_flag', MakeScopeFlag('ucm_trait_immortal_ageless')).End)]"
              tooltipwidget = {
                using = character_trait_tooltip
              }
              hbox = {
                margin = { 8 0 }
                spacing = 8
                icon = {
                  size = { 28 28 }
                  texture = "[GetTrait('ucm_trait_immortal_ageless').GetIcon(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.Self)]"
                }
                text_single = {
                  layoutpolicy_horizontal = expanding
                  text = "[GetTrait('ucm_trait_immortal_ageless').GetName(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.Self)]"
                  default_format = "#clickable"
                  autoresize = no
                }
                text_single = {
                  visible = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_immortal_ageless'))]"
                  text = "ucm_cheat_menu_trait_minus"
                  default_format = "#N"
                }
                text_single = {
                  visible = "[Not(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_immortal_ageless')))]"
                  text = "ucm_cheat_menu_trait_plus"
                  default_format = "#P"
                }
              }
            }
            button_standard_hover = {
              layoutpolicy_horizontal = expanding
              size = { 0 38 }
              datacontext = "[GetTrait('trait_warlord_eternal')]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char]"
              down = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('trait_warlord_eternal'))]"
              onclick = "[GetScriptedGui('ucm_cheat_trait_gui_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trait_flag', MakeScopeFlag('trait_warlord_eternal')).End)]"
