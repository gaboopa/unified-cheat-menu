window = {
  name = "ucm_pillar_picker_window"
  parentanchor = right|vcenter
  size = { 500 720 }
  layer = top
  movable = yes
  alwaystransparent = no
  filter_mouse = all
  visible = "[And( GetVariableSystem.Exists( 'ucm_pillar_picker' ), GetScriptedGui( 'ucm_menu_visible' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
  widget = {
    size = { 100% 100% }
    background = { using = Background_Area_Dark alpha = 1.0 }
  }
  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6
    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" { text = "UCM_PILLAR_PICKER" }
      blockoverride "button_close" { onclick = "[GetVariableSystem.Toggle( 'ucm_pillar_picker' )]" }
    }
    text_single = { layoutpolicy_horizontal = expanding text = "UCM_MENU_TARGET" }
    text_multi = { layoutpolicy_horizontal = expanding autoresize = yes max_width = 460 text = "UCM_PILLAR_NOTE" default_format = "#low" }
    scrollbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      blockoverride "scrollbox_content" {
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 2
          text_single = { layoutpolicy_horizontal = expanding text = "UCM_PILLAR_ETHOS" default_format = "#high" }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_bellicose' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_bellicose' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_bellicose' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_bellicose_name" using = Font_Size_Small } }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_bureaucratic' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_bureaucratic' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_bureaucratic' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_bureaucratic_name" using = Font_Size_Small } }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_communal' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_communal' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_communal' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_communal_name" using = Font_Size_Small } }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_courtly' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_courtly' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_courtly' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_courtly_name" using = Font_Size_Small } }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_egalitarian' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_egalitarian' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_egalitarian' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_egalitarian_name" using = Font_Size_Small } }
          button_standard = { layoutpolicy_horizontal = expanding size = { 0 26 } visible = "[GetScriptedGui( 'ucm_pillar_ethos_spiritual' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" enabled = "[GetScriptedGui( 'ucm_pillar_ethos_spiritual' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" onclick = "[GetScriptedGui( 'ucm_pillar_ethos_spiritual' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" text_single = { parentanchor = center text = "ethos_spiritual_name" using = Font_Size_Small } }
