# 教义库：按类别自由选择教义/信条

window = {
  name = "ucm_acm_faith_doctrine_picker_window"
  parentanchor = center
  position = { 0 0 }
  size = { 720 700 }
  layer = windows_layer # CK3 1.20: there is no "popup" layer; same layer as the other ACM pickers
  filter_mouse = all
  allow_outside = yes
  alwaystransparent = no
  movable = yes

  using = Window_Background
  using = Window_Decoration

  datacontext = "[GetVariableSystem]"
  datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"

  visible = "[GetScriptedGui('ucm_acm_faith_doctrine_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" {
        text = ucm_acm_faith_picker_title
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('ucm_acm_faith_doctrine_picker_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    text_single = {
      layoutpolicy_horizontal = expanding
      text = ucm_acm_faith_picker_hint
      default_format = "#weak"
      autoresize = yes
      max_width = 660
    }

    scrollbox = {
      layoutpolicy_vertical = expanding
      layoutpolicy_horizontal = expanding
      visible = "[GetPlayer.MakeScope.HasFlag('ucm_acm_faith_pick_cat_core_tenets')]"

      blockoverride "scrollbox_content" {
        dynamicgridbox = {
          datamodel = "[GetGlobalList('ucm_acm_doctrine_list_core_tenets')]"
          datamodel_wrap = 2
          flipdirection = yes
          item = {
            widget = {
              datacontext = "[GetTenetType( Scope.GetFlagName )]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"
              datacontext = "[Faith.GetMainRite]"
              ucm_acm_faith_doctrine_picker_tile_tenet = {}
            }
          }
        }
      }
    }

    scrollbox = {
      layoutpolicy_vertical = expanding
      layoutpolicy_horizontal = expanding
      visible = "[GetPlayer.MakeScope.HasFlag('ucm_acm_faith_pick_cat_main_group')]"

      blockoverride "scrollbox_content" {
        dynamicgridbox = {
          datamodel = "[GetGlobalList('ucm_acm_doctrine_list_main_group')]"
          datamodel_wrap = 2
          flipdirection = yes
          item = {
            widget = {
              datacontext = "[GetDoctrineType( Scope.GetFlagName )]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"
              datacontext = "[Faith.GetMainRite]"
              ucm_acm_faith_doctrine_picker_tile = {}
            }
          }
        }
      }
    }

    scrollbox = {
      layoutpolicy_vertical = expanding
      layoutpolicy_horizontal = expanding
      visible = "[GetPlayer.MakeScope.HasFlag('ucm_acm_faith_pick_cat_marriage')]"

      blockoverride "scrollbox_content" {
        dynamicgridbox = {
          datamodel = "[GetGlobalList('ucm_acm_doctrine_list_marriage')]"
          datamodel_wrap = 2
          flipdirection = yes
          item = {
            widget = {
              datacontext = "[GetDoctrineType( Scope.GetFlagName )]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"
              datacontext = "[Faith.GetMainRite]"
              ucm_acm_faith_doctrine_picker_tile = {}
            }
          }
        }
      }
    }

    scrollbox = {
      layoutpolicy_vertical = expanding
      layoutpolicy_horizontal = expanding
      visible = "[GetPlayer.MakeScope.HasFlag('ucm_acm_faith_pick_cat_crimes')]"

      blockoverride "scrollbox_content" {
        dynamicgridbox = {
          datamodel = "[GetGlobalList('ucm_acm_doctrine_list_crimes')]"
          datamodel_wrap = 2
          flipdirection = yes
          item = {
            widget = {
              datacontext = "[GetDoctrineType( Scope.GetFlagName )]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"
              datacontext = "[Faith.GetMainRite]"
              ucm_acm_faith_doctrine_picker_tile = {}
            }
          }
        }
      }
    }

    scrollbox = {
      layoutpolicy_vertical = expanding
      layoutpolicy_horizontal = expanding
      visible = "[GetPlayer.MakeScope.HasFlag('ucm_acm_faith_pick_cat_clergy')]"

      blockoverride "scrollbox_content" {
        dynamicgridbox = {
          datamodel = "[GetGlobalList('ucm_acm_doctrine_list_clergy')]"
          datamodel_wrap = 2
          flipdirection = yes
          item = {
            widget = {
              datacontext = "[GetDoctrineType( Scope.GetFlagName )]"
              datacontext = "[GetPlayer.MakeScope.Var('ucm_selected_faith_var').Faith]"
              datacontext = "[Faith.GetMainRite]"
              ucm_acm_faith_doctrine_picker_tile = {}
            }
          }
        }
      }
    }

  }
}

types ucmAcmDoctrineTypePickerTypes
{
  type ucm_acm_faith_doctrine_picker_tile = button_standard_hover {
    size = { 320 52 }
    tooltip = "ucm_acm_faith_doctrine_picker_tt"

    onclick = "[GetScriptedGui('ucm_acm_faith_editor_add_doctrine').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pick_doctrine', MakeScopeFlag(Scope.GetFlagName)).End)]"

    hbox = {
      margin = { 8 0 }
      spacing = 8

      icon_doctrine = {
        size = { 40 40 }
        texture = "[DoctrineType.GetIcon]"
      }

      text_single = {
        layoutpolicy_horizontal = expanding
        text = "[DoctrineType.GetNameNoTooltip(Faith.Self)]"
        default_format = "#clickable"
        autoresize = no
      }
    }
  }

  # CK3 1.20: tenet tile (tenets are TenetType, evaluated against the faith's main Rite)
  type ucm_acm_faith_doctrine_picker_tile_tenet = button_standard_hover {
    size = { 320 52 }
    tooltip = "FAITH_WINDOW_TENET_TOOLTIP"

    onclick = "[GetScriptedGui('ucm_acm_faith_editor_add_doctrine').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pick_doctrine', MakeScopeFlag(Scope.GetFlagName)).End)]"

    hbox = {
      margin = { 8 0 }
      spacing = 8

      icon = {
        size = { 40 40 }
        texture = "[TenetType.GetIcon( Faith.Self )]"
      }

      text_single = {
        layoutpolicy_horizontal = expanding
        text = "[TenetType.GetNameNoTooltip( Rite.Self )]"
        default_format = "#clickable"
        autoresize = no
      }
    }
  }
}
