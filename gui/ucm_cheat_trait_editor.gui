              down = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_marriage_ban'))]"
              onclick = "[GetScriptedGui('ucm_cheat_trait_gui_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trait_flag', MakeScopeFlag('ucm_trait_marriage_ban')).End)]"
              tooltipwidget = {
                using = character_trait_tooltip
              }
              hbox = {
                margin = { 8 0 }
                spacing = 8
                icon = {
                  size = { 28 28 }
                  texture = "[GetTrait('ucm_trait_marriage_ban').GetIcon(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.Self)]"
                }
                text_single = {
                  layoutpolicy_horizontal = expanding
                  text = "[GetTrait('ucm_trait_marriage_ban').GetName(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.Self)]"
                  default_format = "#clickable"
                  autoresize = no
                }
                text_single = {
                  visible = "[GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_marriage_ban'))]"
                  text = "ucm_cheat_menu_trait_minus"
                  default_format = "#N"
                }
                text_single = {
                  visible = "[Not(GetPlayer.MakeScope.Var('ucm_trait_gui_target').Char.HasTrait(GetTrait('ucm_trait_marriage_ban')))]"
                  text = "ucm_cheat_menu_trait_plus"
                  default_format = "#P"
                }
              }
            }
        }
      }
    }
  }
}
